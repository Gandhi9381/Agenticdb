# ─── LLM Configuration ────────────────────────────────────────
LLM_PROVIDER=google
LLM_MODEL=gemini-2.0-flash
LLM_API_KEY=your_google_gemini_api_key_here

# ─── Database ─────────────────────────────────────────────────
# Main application database (stores metadata, incidents, history)
DATABASE_URL=postgresql://agenticdb_user:agenticdb_pass@localhost:5432/agenticdb

# Separate test database for safe experiments
TEST_DATABASE_URL=postgresql://agenticdb_user:agenticdb_pass@localhost:5432/agenticdb_test

# Optional: user-facing database to monitor (defaults to main if not set)
MONITORED_DATABASE_URL=postgresql://agenticdb_user:agenticdb_pass@localhost:5432/agenticdb

# ─── Monitoring ───────────────────────────────────────────────
MONITOR_INTERVAL_SECONDS=30
SLOW_QUERY_THRESHOLD_MS=1000
ANOMALY_DETECTION_ENABLED=true

# ─── Safety ───────────────────────────────────────────────────
APPROVAL_REQUIRED_FOR_PERSISTENT_CHANGES=true
MAX_QUERY_ROWS=10000
QUERY_TIMEOUT_SECONDS=30

# ─── Application ──────────────────────────────────────────────
APP_ENV=development
SECRET_KEY=change_this_to_a_secure_random_string
DEBUG=true
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Sample Data ──────────────────────────────────────────────
SAMPLE_DATA_ROWS=1000
SAMPLE_DATA_SEED=42
