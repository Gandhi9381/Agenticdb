# ─── LLM Configuration ────────────────────────────────────────
# Supported provider: google (Google Gemini)
# Recommended models: gemini-2.0-flash, gemini-1.5-flash, gemini-1.5-pro
LLM_PROVIDER=google
LLM_MODEL=gemini-2.0-flash
# Get your Gemini API key from https://aistudio.google.com/
LLM_API_KEY=your_google_gemini_api_key_here

# Optional aliases supported:
# GEMINI_API_KEY=your_google_gemini_api_key_here
# GOOGLE_API_KEY=your_google_gemini_api_key_here

# ─── Database ─────────────────────────────────────────────────
DATABASE_URL=sqlite:///./agenticdb.db
MONITOR_INTERVAL_SECONDS=30
SLOW_QUERY_THRESHOLD_MS=500
APPROVAL_REQUIRED_FOR_PERSISTENT_CHANGES=true
MAX_QUERY_ROWS=10000
QUERY_TIMEOUT_SECONDS=30
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
DEBUG=true
SAMPLE_DATA_ROWS=500
SAMPLE_DATA_SEED=42
